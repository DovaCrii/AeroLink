APP_ENV=dev
APP_SECRET_KEY=replace-with-a-long-random-secret
APP_BASE_URL=http://127.0.0.1:8000

# Supplied by DJI Developer when the controlled Pilot 2 test is approved.
DJI_APP_ID=
DJI_APP_KEY=
DJI_APP_LICENSE=

DATABASE_URL=postgresql+psycopg://aerolink:aerolink@127.0.0.1:5432/aerolink
REDIS_URL=redis://127.0.0.1:6379/0
POSTGRES_PASSWORD=change-me
MINIO_ROOT_USER=change-me
MINIO_ROOT_PASSWORD=change-me

ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=

MQTT_HOST=127.0.0.1
MQTT_PORT=8883
MQTT_PUBLIC_HOST=
MQTT_TLS_PORT=8883
MQTT_TLS_CERT_FILE=
MQTT_TLS_KEY_FILE=
MQTT_AUTH_MODE=http

OBJECT_STORAGE_ENDPOINT=http://127.0.0.1:9000
OBJECT_STORAGE_BUCKET=aerolink-evidence
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=

TELEMETRY_RETENTION_DAYS=90
EVIDENCE_RETENTION_DAYS=1825
LOG_LEVEL=INFO

# AL-107 / ADR-0003: credencial de servicio que AeroControl presenta para leer
# el inventario de dispositivos. Sin valor, el endpoint responde 503 y no
# expone nada. Es un control de segmentación, no de secreto: ambos servicios
# comparten VM. Se elimina cuando AL-103 (Entra ID) aterrice.
SERVICE_TOKEN=
SERVICE_TOKEN_WORKSPACE=
SERVICE_TOKEN_SUBJECT=svc:aerocontrol
