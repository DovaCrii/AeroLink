APP_ENV=dev
APP_SECRET_KEY=replace-with-a-long-random-secret
APP_BASE_URL=http://127.0.0.1:8000

# Supplied by DJI Developer when the controlled Pilot 2 test is approved.
DJI_APP_ID=
DJI_APP_KEY=
DJI_APP_LICENSE=

DATABASE_URL=postgresql+psycopg://aerolink:aerolink@127.0.0.1:5432/aerolink
POSTGRES_PASSWORD=change-me
MINIO_ROOT_USER=change-me
MINIO_ROOT_PASSWORD=change-me

MQTT_PUBLIC_HOST=
MQTT_TLS_PORT=8883
MQTT_TLS_CERT_FILE=
MQTT_TLS_KEY_FILE=

# ADR-0004: MQTT_PUBLIC_HOST/MQTT_TLS_PORT nombran el **relay externo**, no p340
# -- p340 no tiene ingreso TCP desde internet (AL-003, medido el 2026-08-10). Las
# credenciales de abajo son la identidad con que el worker se **suscribe** a ese
# relay, distinta de la que DJI Pilot 2 usa para publicar. Sin ellas el worker no
# arranca: no tiene default al que caer.
MQTT_WORKER_CLIENT_ID=aerolink-worker
MQTT_WORKER_USERNAME=
MQTT_WORKER_PASSWORD=
MQTT_WORKER_TOPIC=thing/product/+/#

# AL-106: el worker es otro proceso, así que expone sus propias métricas en este
# puerto (loopback-only en docker-compose). 0 desactiva la exposición.
WORKER_METRICS_PORT=9100

# AL-105: la evidencia se guarda por la API S3, así que el endpoint es MinIO en
# p340 hoy y podría ser un bucket real sin cambiar código. Sin credenciales,
# AeroLink se niega a construir el cliente: uno anónimo escribiría evidencia que
# nadie autenticó.
OBJECT_STORAGE_ENDPOINT=http://127.0.0.1:9000
OBJECT_STORAGE_BUCKET=aerolink-evidence
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_REGION=us-east-1

# EVIDENCE_RETENTION_DAYS es la ventana que consulta `expired_evidence`. Nada la
# borra automáticamente: eliminar evidencia de 5 años es una operación explícita,
# y no antes de que AL-405 demuestre que una restauración funciona.
TELEMETRY_RETENTION_DAYS=90
EVIDENCE_RETENTION_DAYS=1825
LOG_LEVEL=INFO

# AL-107 / ADR-0003: credencial de servicio que AeroControl presenta para leer
# el inventario de dispositivos. Sin valor, el endpoint responde 503 y no
# expone nada. Es un control de segmentación, no de secreto: ambos servicios
# comparten VM. Se elimina cuando AL-103 (Entra ID) aterrice.
SERVICE_TOKEN=
SERVICE_TOKEN_WORKSPACE=
SERVICE_TOKEN_SUBJECT=svc:aerocontrol
